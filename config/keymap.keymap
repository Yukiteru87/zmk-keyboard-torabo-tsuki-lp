#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/runtime-input-processor.dtsi>

// torabo-tsuki LP XS 用キーマップ (案 B: 記号直打ち)
// - 位置は L 配列の 66 個の通し番号で並べている。XS に無い位置は &none
// - XS の右手最下段は、ボールのため真ん中の 2 キー (L61, L62) が無い
// - レイヤー: 0 BASE / 1 MOUSE / 2 SYM / 3 NAV / 4 SCROLL / 5 NUM / 6 ADJUST
//   (MOUSE=1 と SCROLL=4 は runtime input processor の設定と対応しているので番号を変えない)

// ---- OS の配列が JIS のときの記号 (ZMK のキー名は US 配列基準のため読み替える) ----
#define JP_EXCL  LS(N1)        // !
#define JP_DQT   LS(N2)        // "
#define JP_HASH  LS(N3)        // #
#define JP_DLLR  LS(N4)        // $
#define JP_PRCNT LS(N5)        // %
#define JP_AMPS  LS(N6)        // &
#define JP_SQT   LS(N7)        // '
#define JP_LPAR  LS(N8)        // (
#define JP_RPAR  LS(N9)        // )
#define JP_MINUS MINUS         // -
#define JP_EQUAL LS(MINUS)     // =
#define JP_CARET EQUAL         // ^
#define JP_TILDE LS(EQUAL)     // ~
#define JP_YEN   INT3          // ¥
#define JP_PIPE  LS(INT3)      // |
#define JP_AT    LBKT          // @
#define JP_GRAVE LS(LBKT)      // `
#define JP_LBKT  RBKT          // [
#define JP_LBRC  LS(RBKT)      // {
#define JP_RBKT  BSLH          // ]  (Mac は要確認。出ない場合は NON_US_HASH)
#define JP_RBRC  LS(BSLH)      // }
#define JP_COLON SQT           // :
#define JP_STAR  LS(SQT)       // *
#define JP_PLUS  LS(SEMI)      // +
#define JP_LT    LS(COMMA)     // <
#define JP_GT    LS(DOT)       // >
#define JP_SLASH SLASH         // /
#define JP_QMARK LS(SLASH)     // ?
#define JP_BSLH  INT1          // \ (ろ)
#define JP_UNDER LS(INT1)      // _

// ---- トラックボールの初期設定 (DYA Studio から実行時に変更・保存できる) ----
// オートマウスレイヤー: ボールを動かすと layer 1 (MOUSE) を自動で有効化
//   activation-delay   : 直前のキー入力からこの時間はAMLを発動しない(タイピング中の誤発動防止)
//   deactivation-delay : ボールを止めてからAMLを解除するまでの時間
//   MOUSE レイヤーで &trans 以外のキー(クリック等)や修飾キーを押してもAMLは解除されない
// ポインタ速度: 0.5 倍 (DYA Studio で保存した値があればそちらが優先される)
&mouse_runtime_input_processor {
    scale-multiplier = <1>;
    scale-divisor = <2>;
    temp-layer-enabled;
    temp-layer = <1>;
    temp-layer-activation-delay-ms = <200>;
    temp-layer-deactivation-delay-ms = <800>;
};

// スクロール: layer 4 (SCROLL) が有効な間だけボールの動きをスクロールに変換
&scroll_runtime_input_processor {
    active-layers = <(1 << 4)>;
    scale-multiplier = <1>;
    scale-divisor = <8>;
};

// 精密モード: 押している間ポインタ速度を 1/4 にする (全体速度 0.5 の半分。全体速度とは別の固定値)
&rip_ldpi {
    display-name = "Precision (0.25x)";
    scale-multiplier = <1>;
    scale-divisor = <4>;
};

// ---- タップ / ホールドの判定 ----
// Tab/Ctrl, 英数/SYM, かな/NAV: 他のキーを押して離すまで続けたらホールド
&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        // Space/NUM: 文字を打った直後(125ms 以内)は必ず Space。長押し(200ms)で NUM
        lt_spc: layer_tap_space {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Space / Layer";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&mo>, <&kp>;
        };
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        // 英数(SYM) と かな(NAV) を同時にホールドすると ADJUST
        adjust {
            if-layers = <2 3>;
            then-layer = <6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
&none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &none
&none            &kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp P            &none
&none            &kp A            &kp S            &kp D            &kp F            &kp G            &none            &none            &kp H            &kp J            &kp K            &kp L            &kp SEMI         &none
&none            &kp Z            &kp X            &kp C            &kp V            &kp B            &kp ESC          &kp MINUS        &kp N            &kp M            &kp COMMA        &kp DOT          &kp SLASH        &none
&none            &mt LCTRL TAB    &kp LGUI         &kp LALT         &kp LSHFT        &lt 2 LANG2      &lt_spc 5 SPACE  &kp ENTER        &lt 3 LANG1      &none            &none            &kp BSPC         &kp RSHFT        &none
            >;
        };

        layer_1 {
            display-name = "MOUSE";
            bindings = <
&none      &none      &none      &none      &none      &none      &none      &none      &none      &none      &none      &none
&none      &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &none
&none      &rip_ldpi  &mo 4      &mkp RCLK  &mkp LCLK  &trans     &none      &none      &trans     &mkp LCLK  &mkp RCLK  &mo 4      &trans     &none
&none      &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &none
&none      &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &none      &none      &trans     &trans     &none
            >;
        };

        layer_2 {
            display-name = "SYM";
            bindings = <
&none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
&none         &kp JP_EXCL   &kp JP_DQT    &kp JP_HASH   &kp JP_DLLR   &kp JP_PRCNT  &kp JP_AMPS   &kp JP_LBKT   &kp JP_RBKT   &kp JP_SQT    &kp JP_AT     &none
&none         &kp JP_TILDE  &kp JP_CARET  &kp JP_EQUAL  &kp JP_MINUS  &kp JP_PLUS   &none         &none         &kp JP_LT     &kp JP_LPAR   &kp JP_RPAR   &kp JP_GT     &kp JP_COLON  &none
&none         &kp JP_GRAVE  &kp JP_PIPE   &kp JP_BSLH   &kp JP_UNDER  &kp JP_STAR   &kp JP_YEN    &trans        &kp JP_QMARK  &kp JP_LBRC   &kp JP_RBRC   &trans        &trans        &none
&none         &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &none         &none         &trans        &trans        &none
            >;
        };

        layer_3 {
            display-name = "NAV";
            bindings = <
&none      &none      &none      &none      &none      &none      &none      &none      &none      &none      &none      &none
&none      &none      &none      &kp UP     &none      &none      &none      &none      &kp PSCRN  &none      &none      &none
&none      &none      &kp LEFT   &kp DOWN   &kp RIGHT  &none      &none      &none      &none      &kp INS    &kp HOME   &kp PG_UP  &kp BSPC   &none
&none      &none      &none      &none      &none      &none      &none      &none      &none      &kp DEL    &kp END    &kp PG_DN  &none      &none
&none      &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &none      &none      &trans     &trans     &none
            >;
        };

        layer_4 {
            display-name = "SCROLL";
            bindings = <
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none
&none   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&none   &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans  &none
&none   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&none   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &none
            >;
        };

        layer_5 {
            display-name = "NUM";
            bindings = <
&none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
&none         &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp JP_SLASH  &kp N7        &kp N8        &kp N9        &kp JP_MINUS  &none
&none         &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &none         &none         &kp JP_STAR   &kp N4        &kp N5        &kp N6        &kp JP_PLUS   &none
&none         &kp F11       &kp F12       &none         &none         &none         &none         &none         &kp DOT       &kp N1        &kp N2        &kp N3        &kp JP_EQUAL  &none
&none         &trans        &trans        &trans        &trans        &trans        &trans        &kp N0        &trans        &none         &none         &trans        &trans        &none
            >;
        };

        layer_6 {
            display-name = "ADJUST";
            bindings = <
&none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
&none         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none         &none         &none         &none         &bt BT_CLR    &none
&none         &out OUT_USB  &out OUT_BLE  &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
&none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
&none         &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &none         &none         &trans        &trans        &none
            >;
        };
    };
};

